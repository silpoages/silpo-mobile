{
  "name": "silpo-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": "22.18.0"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.25",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.26",
    "expo-sqlite": "57.0.2",
    "expo-status-bar": "57.0.1",
    "html2pdf.js": "^0.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "husky": "9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "16.4.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "test-renderer": "^1.3.1",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setupEnv.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.tsx"
    ],
    "testMatch": [
      "<rootDir>/{app,src,test}/**/*.test.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
    },
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "src/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/*.test.{ts,tsx}",
      "!**/index.ts"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90
      }
    },
    "testTimeout": 15000
  }
}
