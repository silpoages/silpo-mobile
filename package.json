{
  "name": "silpo-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": "22.18.0"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "54.0.37",
    "expo-sqlite": "16.0.10",
    "expo-status-bar": "3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
